# Sunshine Global Community Services — environment placeholders
#
# Copy this file to `.env.local` for local static builds.
# Never commit real secrets. Do not put production secrets in source control.
#
# SITE URL (public — baked into static export at build time)
# ------------------------------------------------------------
# Local testing:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production Cloudflare Pages build environment (set in dashboard, not here):
# NEXT_PUBLIC_SITE_URL=https://sunshineservices.org
#
# Turnstile site key (public — designed for browser use)
# ------------------------------------------------------
# Cloudflare official ALWAYS-PASSES test site key (local only):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x0000000000000000000000000000000AA
# Production: set the real Turnstile site key in Cloudflare Pages build env.
#
# WhatsApp Business (public — digits only, country code + number, no +/spaces)
# -------------------------------------------------------------------------
# Used to build https://wa.me/<NUMBER> for the footer WhatsApp button.
# Do not invent a number. Leave unset until the confirmed Business number is ready.
# Example shape only (not a real Sunshine number): 13125550100
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# Production: set in Cloudflare Pages build env (and optionally wrangler.toml [vars]).
#
# Cloudflare Pages Function secrets (server-side only — never NEXT_PUBLIC_)
# -------------------------------------------------------------------------
# Configure in Cloudflare Pages secrets or `.dev.vars` for local wrangler.
# See `.dev.vars.example` for local Turnstile test secrets.
# Do not commit real production values.
#
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=
# RATE_LIMIT_SECRET=
#
# Cloudflare Pages Function variables (non-secret)
# ------------------------------------------------
# ALLOWED_ORIGIN=https://sunshineservices.org
# ENVIRONMENT=production
# INQUIRY_EMAIL_TO=info@sunshineservices.org
# INQUIRY_EMAIL_FROM=noreply@sunshineservices.org
#
# Gmail Send mail as (staff replies — configured in Gmail, not in this repo)
# -------------------------------------------------------------------------
# Address: info@sunshineservices.org
# SMTP host/username/password: use current Resend SMTP documentation.
# Use a dedicated Resend API key for Gmail SMTP if supported.
#
# Cloudflare Email Routing (INBOUND ONLY)
# ---------------------------------------
# Route info@sunshineservices.org → sunshineservices@gmail.com
# Use exact DNS records from the Cloudflare Email Routing dashboard.
