# Sunshine Global Community Services — environment placeholders
#
# Copy this file to `.env.local` for local development.
# Never commit real secrets. Do not put production secrets in source control.
#
# SITE URL (public)
# -----------------
# Canonical/public site URL used for metadata, sitemap, and Open Graph.
# Local development: http://localhost:3000 is fine.
# Temporary Render hosting: set to your Render service URL after deploy
# (e.g. https://your-service.onrender.com) until a permanent domain is purchased.
# Do not commit real secrets. Set this in Render Environment, not in git.
NEXT_PUBLIC_SITE_URL=https://example.com

# Donate Goods inquiry delivery (server-side only — never NEXT_PUBLIC_)
# --------------------------------------------------------------------
# Do not invent a Sunshine email address. Set these only when a real mailbox
# and email vendor are approved by the Project Manager.
#
# Delivery remains disabled until:
# 1) a real mailbox is confirmed
# 2) a vendor is selected and wired
# 3) delivery is verified
# 4) EMAIL_PROVIDER_READY=true
#
# INQUIRY_EMAIL_TO=
# INQUIRY_EMAIL_FROM=
# EMAIL_PROVIDER_API_KEY=
# EMAIL_PROVIDER_READY=false

# Rate limiting (server-side only — never NEXT_PUBLIC_)
# ----------------------------------------------------
# Salt used when hashing client identifiers for rate-limit keys.
# Required for production-strength hashing. Do not invent a value in git.
#
# RATE_LIMIT_SECRET=

# Future managed services (not used yet)
# DONATION_PROCESSOR_SECRET_KEY=
# ANALYTICS_MEASUREMENT_ID=
